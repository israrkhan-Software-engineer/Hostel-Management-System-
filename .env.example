# ── Node environment ─────────────────────────────────────────────────────────
NODE_ENV=development

# ── Application ───────────────────────────────────────────────────────────────
# proposed default: Asia/Karachi (SRS V2 §6.3, NFR-020); pending owner approval
APP_TIMEZONE=Asia/Karachi
# proposed default: PKR (SRS V2 §6.3, NFR-020); pending owner approval
APP_DEFAULT_CURRENCY=PKR
PUBLIC_API_URL=http://localhost:3001

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# proposed: PostgreSQL (SRS V2 §2.5, §13.4); pending stack approval (G-02/OD-13)
POSTGRES_VERSION=16
POSTGRES_DB=hms_dev
POSTGRES_USER=hms_user
POSTGRES_PASSWORD=CHANGE_ME_dev_only
DATABASE_URL=postgresql://hms_app:CHANGE_ME_app_dev_only@postgres:5432/hms_dev?schema=public
DATABASE_MIGRATION_URL=postgresql://hms_user:CHANGE_ME_dev_only@postgres:5432/hms_dev?schema=public
HMS_APP_PASSWORD=CHANGE_ME_app_dev_only
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────────────────────
# proposed: Redis for cache and queue (SRS V2 §2.5); pending G-02/OD-13
REDIS_VERSION=7
REDIS_URL=redis://redis:6379

# ── JWT / session ─────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_replace_in_every_env
PLATFORM_JWT_SECRET=CHANGE_ME_unique_platform_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
API_RATE_LIMIT_PER_MINUTE=10000
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
TENANT_MFA_ENABLED=true

# ── Field-level encryption ────────────────────────────────────────────────────
# Used for CNIC, health/accessibility fields, MFA secrets (SRS V2 §6.5, §13.3)
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_hex_chars_replace_in_every_env

# ── Object storage (S3-compatible / SeaweedFS for local Compose) ───────────────
OBJECT_STORAGE_URL=http://object-storage:8333
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME_access_key
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_secret_key
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SSE=
OBJECT_STORAGE_AUTO_CREATE_BUCKET=false
OBJECT_STORAGE_BUCKET_PRIVATE_PROOFS=private-proofs
OBJECT_STORAGE_BUCKET_PRIVATE_DOCS=private-documents
OBJECT_STORAGE_BUCKET_PRIVATE_EXPORTS=private-exports
OBJECT_STORAGE_BUCKET_PUBLIC_IMAGES=public-approved-images

# ── Notification providers ────────────────────────────────────────────────────
# Supported email provider: resend. Supported SMS provider: twilio. Blank disables delivery.
NOTIFICATION_EMAIL_PROVIDER=
NOTIFICATION_SMS_PROVIDER=
NOTIFICATION_PUSH_PROVIDER=
APP_FRONTEND_URL=http://localhost:3000
NOTIFICATION_EMAIL_API_KEY=
NOTIFICATION_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use the E.164 sender number configured in the Twilio account.
TWILIO_FROM_NUMBER=

# ── Payment provider ──────────────────────────────────────────────────────────
# Scope pending owner decision (G-07 / OD-01); leave blank — manual proof only
PAYMENT_PROVIDER=

# ── Biometric provider ────────────────────────────────────────────────────────
# Hardware/provider pending owner decision (G-08 / OD-03); leave blank to disable
BIOMETRIC_PROVIDER=

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/hms
# Retention period is policy-driven (G-09 / OD-06); do NOT hardcode
BACKUP_RETENTION_DAYS=PENDING_OWNER_DECISION
BACKUP_GPG_RECIPIENT=

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
# Email identity of an active Super Admin used by the worker for RLS-scoped SaaS maintenance.
PLATFORM_WORKER_ADMIN_EMAIL=

# ── Nginx versions ────────────────────────────────────────────────────────────
NGINX_VERSION=1.25
