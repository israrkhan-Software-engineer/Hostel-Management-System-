model VisitorVisit {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  branchId           String             @map("branch_id") @db.Uuid
  branch             Branch             @relation(fields: [branchId], references: [id])
  hostResidentId     String             @map("host_resident_id") @db.Uuid
  hostResident       Resident           @relation(fields: [hostResidentId], references: [id])
  visitorName        String             @map("visitor_name")
  visitorPhone       String?            @map("visitor_phone")
  cnicEncrypted      String?            @map("cnic_encrypted")
  cnicFingerprint    String?            @map("cnic_fingerprint")
  purpose            String
  status             VisitorVisitStatus @default(PENDING)
  createdByUserId    String             @map("created_by_user_id") @db.Uuid
  createdBy          User               @relation("VisitorVisitCreator", fields: [createdByUserId], references: [id])
  approvedByUserId   String?            @map("approved_by_user_id") @db.Uuid
  approvedBy         User?              @relation("VisitorVisitApprover", fields: [approvedByUserId], references: [id])
  approvedAt         DateTime?          @map("approved_at")
  checkedInByUserId  String?            @map("checked_in_by_user_id") @db.Uuid
  checkedInBy        User?              @relation("VisitorVisitCheckInActor", fields: [checkedInByUserId], references: [id])
  checkedInAt        DateTime?          @map("checked_in_at")
  checkedOutByUserId String?            @map("checked_out_by_user_id") @db.Uuid
  checkedOutBy       User?              @relation("VisitorVisitCheckOutActor", fields: [checkedOutByUserId], references: [id])
  checkedOutAt       DateTime?          @map("checked_out_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  @@index([tenantId, branchId, status, createdAt])
  @@index([tenantId, branchId, visitorName, createdAt])
  @@index([tenantId, cnicFingerprint])
  @@index([tenantId, hostResidentId, createdAt])
  @@index([tenantId, branchId, deletedAt])
  @@map("visitor_visits")
}

