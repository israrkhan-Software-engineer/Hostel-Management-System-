model RoomTransfer {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  branchId             String        @map("branch_id") @db.Uuid
  branch               Branch        @relation(fields: [branchId], references: [id])
  residentId           String        @map("resident_id") @db.Uuid
  resident             Resident      @relation(fields: [residentId], references: [id])
  fromBedId            String        @map("from_bed_id") @db.Uuid
  fromBed              Bed           @relation("RoomTransferFromBed", fields: [fromBedId], references: [id])
  fromRoomCode         String        @map("from_room_code")
  fromBedCode          String        @map("from_bed_code")
  toBedId              String        @map("to_bed_id") @db.Uuid
  toBed                Bed           @relation("RoomTransferToBed", fields: [toBedId], references: [id])
  toRoomCode           String        @map("to_room_code")
  toBedCode            String        @map("to_bed_code")
  previousAllocationId String        @map("previous_allocation_id") @db.Uuid
  previousAllocation   BedAllocation @relation("RoomTransferPreviousAllocation", fields: [previousAllocationId], references: [id])
  newAllocationId      String        @map("new_allocation_id") @db.Uuid
  newAllocation        BedAllocation @relation("RoomTransferNewAllocation", fields: [newAllocationId], references: [id])
  reason               String
  transferredByUserId  String        @map("transferred_by_user_id") @db.Uuid
  transferredBy        User          @relation("RoomTransferActor", fields: [transferredByUserId], references: [id])
  transferredAt        DateTime      @default(now()) @map("transferred_at")

  @@index([tenantId, branchId, residentId, transferredAt])
  @@map("room_transfers")
}
