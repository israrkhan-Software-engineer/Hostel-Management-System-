  body            String
  status          NoticeStatus @default(DRAFT)
  startsAt        DateTime?    @map("starts_at") @db.Date
  endsAt          DateTime?    @map("ends_at") @db.Date
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  createdBy       User         @relation("NoticeCreator", fields: [createdByUserId], references: [id])
  publishedAt     DateTime?    @map("published_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([tenantId, branchId, status, startsAt, endsAt])
  @@map("notices")
}

